---
import BaseLayout from '../layouts/BaseLayout.astro';
import Room from '../components/Room.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES } from '../consts';
import { getPosts, postUrl, roman, isoDate, formatDate, type Post } from '../lib/posts';

const posts = await getPosts();
const years = new Map<number, Post[]>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  years.set(y, [...(years.get(y) || []), p]);
}
const pad = (n: number) => String(n).padStart(2, '0');
const data = {
  posts: posts.map((p) => ({
    title: p.data.title,
    url: postUrl(p),
    year: p.data.date.getUTCFullYear(),
    date: formatDate(p.data.date),
    cat: p.data.category,
    hall: CATEGORIES[p.data.category].hall,
  })),
};
---
<BaseLayout title="城堡 · 归档" description="全部文章，按年份编排">
  <Room
    room="keep"
    title="城堡 · 藏书楼"
    latin="The Keep Library"
    motto={`主楼的书架上按年份收着全部文章，共 ${posts.length} 卷。最上面一层是最新的一年。`}
    icon="castle"
    hint="把鼠标移到烫金书脊上，书会探出来；点一下就翻开它。"
    crumbs={[{ name: '归档' }]}
    data={data}
  />

  <div class="wrap page">
    <section class="block">
      <div class="sec-head reveal">
        <span class="shield"><Icon name="tome" /></span>
        <div><h2>编年史</h2><p class="motto">The Chronicle</p></div>
        <span class="rule"></span>
      </div>
      {posts.length === 0 && <p class="empty"><Icon name="castle" />编年史还是空白的。</p>}
      {[...years.entries()].map(([y, list]) => (
        <div class="year reveal">
          <div class="year-mark"><b>{y}</b><small>{roman(y)}</small><small>{list.length} 篇</small></div>
          <ol>
            {list.map((p) => (
              <li>
                <time datetime={isoDate(p.data.date)}>{pad(p.data.date.getUTCMonth() + 1)} · {pad(p.data.date.getUTCDate())}</time>
                <a href={postUrl(p)}>{p.data.title}</a>
                <span class="hall-name">{CATEGORIES[p.data.category].hall}</span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>

<script>
  const el = document.getElementById('room-stage');
  if (el) import('../scripts/rooms/archive.js').then((m) => m.mount(el)).catch((err) => { console.warn(err); el.classList.add('is-fallback'); });
</script>
